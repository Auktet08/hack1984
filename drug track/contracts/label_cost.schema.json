{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "label_cost.schema.json",
  "title": "Label run cost (out/startup/labels/<corpus>.<backend>.cost.json)",
  "description": "Written by label.py after every full run (not --limit runs). Gemini: tokens times a dated price. Local: wall time and hardware.",
  "type": "object",
  "required": ["corpus", "backend", "labeler", "model", "stand_in", "items", "wall_s", "tokens", "price",
               "usd_total", "usd_per_100", "s_per_100", "data_left_device", "hardware", "measured_at"],
  "properties": {
    "corpus": {"type": "string", "minLength": 1},
    "backend": {"enum": ["gemini", "local"]},
    "labeler": {"type": "string"},
    "model": {"type": "string"},
    "stand_in": {"type": "boolean"},
    "items": {"type": "integer", "minimum": 1},
    "wall_s": {"type": ["number", "null"], "minimum": 0},
    "tokens": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["input", "output"],
          "properties": {
            "input": {"type": "integer", "minimum": 0},
            "output": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "price": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["input_per_m", "output_per_m", "source_url", "checked"],
          "properties": {
            "input_per_m": {"type": "number", "minimum": 0},
            "output_per_m": {"type": "number", "minimum": 0},
            "source_url": {"type": "string", "pattern": "^https?://"},
            "checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        }
      ]
    },
    "usd_total": {"type": ["number", "null"], "minimum": 0},
    "usd_per_100": {"type": ["number", "null"], "minimum": 0},
    "s_per_100": {"type": ["number", "null"], "minimum": 0},
    "data_left_device": {"type": "boolean"},
    "hardware": {"type": ["string", "null"]},
    "measured_at": {"type": "string"}
  },
  "allOf": [
    {
      "description": "Stand-in labels come from a hosted API, so their data always leaves the device.",
      "if": {"properties": {"stand_in": {"const": true}}},
      "then": {"properties": {"data_left_device": {"const": true}}}
    },
    {
      "if": {"properties": {"backend": {"const": "gemini"}}},
      "then": {"properties": {"tokens": {"type": "object"}, "price": {"type": "object"}}}
    }
  ]
}
